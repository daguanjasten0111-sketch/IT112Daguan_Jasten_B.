#include <stdio.h>

int main() {
    FILE *file;
    char note[200];
    int n, i;

    file = fopen("notes.txt", "w");

    if (file == NULL) {
        printf("Error opening file!");
        return 1;
    }

    printf("How many notes do you want to record? ");
    scanf("%d", &n);
    getchar();

    for (i = 1; i <= n; i++) {
        printf("Note %d: ", i);
        fgets(note, sizeof(note), stdin);
        fputs(note, file);
    }

    fclose(file);

    printf("\nInitial notes saved successfully.\n");

    file = fopen("notes.txt", "a");

    if (file == NULL) {
        printf("Error opening file!");
        return 1;
    }

    printf("\nEnter one additional note: ");
    fgets(note, sizeof(note), stdin);
    fputs(note, file);

    fclose(file);

    printf("\nNew note added successfully.\n");

    file = fopen("notes.txt", "r");

    if (file == NULL) {
        printf("Error opening file!");
        return 1;
    }

    printf("\nReading Saved Notes:\n");

    while (fgets(note, sizeof(note), file) != NULL) {
        printf("%s", note);
    }

    fclose(file);

    return 0;
}
